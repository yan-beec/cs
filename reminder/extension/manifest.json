{
  "manifest_version": 3,
  "name": "ICS Chatwoot 页面连接",
  "version": "1.0.2",
  "description": "配合 ICS 桌面提醒，在已登录的 Chatwoot 标签页中打开客户会话。",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "scripting", "storage", "alarms"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": {"service_worker": "background.js", "type": "module"},
  "options_page": "options.html",
  "action": {"default_title": "ICS 浏览器连接设置"},
  "icons": {"16": "icons/16.png", "48": "icons/48.png", "128": "icons/128.png"},
  "minimum_chrome_version": "105"
}
