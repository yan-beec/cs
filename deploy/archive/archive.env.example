# Add this section to the existing project root .env; do not replace it.
# Use a different random password per role and keep POSTGRES_* unchanged.
ARCHIVE_POSTGRES_DB=ics_quality
ARCHIVE_POSTGRES_HOST=archive-postgres
ARCHIVE_POSTGRES_PORT=5432
ARCHIVE_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
ARCHIVE_INGEST_USER=archive_ingest
ARCHIVE_INGEST_PASSWORD=REPLACE_WITH_RANDOM_INGEST_PASSWORD
ARCHIVE_READER_USER=archive_reader
ARCHIVE_READER_PASSWORD=REPLACE_WITH_RANDOM_READER_PASSWORD
ARCHIVE_QUALITY_USER=archive_quality
ARCHIVE_QUALITY_PASSWORD=REPLACE_WITH_RANDOM_QUALITY_PASSWORD
ARCHIVE_POSTGRES_POOL_SIZE=5

# Archive browsing in the existing administrator backend; enable after migration 002.
ARCHIVE_QUERY_ENABLED=false
ARCHIVE_QUERY_POOL_SIZE=2
ARCHIVE_ASSIGNMENT_SYNC_ENABLED=false
ARCHIVE_ASSIGNMENT_USER=archive_assignment
ARCHIVE_ASSIGNMENT_PASSWORD=REPLACE_WITH_RANDOM_ASSIGNMENT_PASSWORD
ARCHIVE_EXPORT_MAX_ENTITIES=20000
ARCHIVE_EXPORT_MAX_MESSAGES=100000
ARCHIVE_EXPORT_MAX_BYTES=134217728
ARCHIVE_EXPORT_TIMEOUT_SECONDS=120
ARCHIVE_PROCESSOR_POOL_SIZE=2
ARCHIVE_PROCESSOR_LEASE_SECONDS=120
ARCHIVE_PROCESSOR_POLL_SECONDS=2
ARCHIVE_PROCESSOR_MAX_ATTEMPTS=8
ARCHIVE_PROCESSOR_MAX_CONVERSATION_EVENTS=20000
ARCHIVE_PROCESSOR_MAX_CONVERSATION_BYTES=67108864

# Optional signed Chatwoot account-webhook receiver (quality-capture profile).
# Fill the actual account IDs and the Secret of this dedicated account webhook.
ARCHIVE_SOURCE_KEY=chatwoot-main
ARCHIVE_ALLOWED_ACCOUNT_IDS=
ARCHIVE_WEBHOOK_SECRET=
# Initial host-only check; for same-server private access, set the actual server private IP.
# Example: ARCHIVE_RECEIVER_HOST=172.20.48.12 (use the same private IP as ICS).
ARCHIVE_RECEIVER_HOST=127.0.0.1
ARCHIVE_RECEIVER_PORT=3010
ARCHIVE_WEBHOOK_TOLERANCE_SECONDS=300
ARCHIVE_RECEIVER_MAX_BODY_BYTES=2097152

# ICS opens an independent read-only pool only when ARCHIVE_QUERY_ENABLED=true.
# The processing worker has its own ingestion pool and never uses the ICS database.
# No host port is published; archive-postgres resolves inside the cs network.
