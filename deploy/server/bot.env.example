# 服务器首次部署模板。复制到项目根目录 .env 后填写；不要覆盖本机正在使用的 .env。
# 适用：Ubuntu 22.04/24.04 x86_64，docker compose -f docker-compose.yml。
# 业务策略、超时和并发与当前根 .env.example 对齐；地址、凭据按服务器填写。
APP_ENV=production
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# 仅用于 Docker 构建，修改后重新 build；不改变本机 cs 环境的 pip 配置。
# 普通 Python 依赖使用清华 PyPI 镜像；CPU PyTorch 使用南大专用镜像。
# CPU 源备用：https://mirror.sjtu.edu.cn/pytorch-wheels/cpu
BUILD_PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
BUILD_TORCH_INDEX_URL=https://mirrors.nju.edu.cn/pytorch/whl/cpu
BUILD_PIP_TIMEOUT=120
BUILD_PIP_RETRIES=8

# 机器人自己的 PostgreSQL，不连接 Chatwoot 的业务数据库。
# POSTGRES_DB（容器建库）与 POSTGRES_DATABASE（应用连接）必须一致。
POSTGRES_DB=cs
POSTGRES_DATABASE=cs
POSTGRES_USER=cs
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_DSN=
POSTGRES_SSLMODE=disable
POSTGRES_POOL_SIZE=12
POSTGRES_POOL_ACQUIRE_TIMEOUT=1.0

# Optional independent archive/quality PostgreSQL; enable with docker-compose.archive.yml.
# Store these alongside existing settings in .env; use independent random passwords.
# ICS receives the reader credential; admin/ingest/quality passwords are masked for the bot.
ARCHIVE_POSTGRES_DB=ics_quality
ARCHIVE_POSTGRES_HOST=archive-postgres
ARCHIVE_POSTGRES_PORT=5432
ARCHIVE_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ARCHIVE_ADMIN_PASSWORD
ARCHIVE_INGEST_USER=archive_ingest
ARCHIVE_INGEST_PASSWORD=REPLACE_WITH_RANDOM_ARCHIVE_INGEST_PASSWORD
ARCHIVE_READER_USER=archive_reader
ARCHIVE_READER_PASSWORD=REPLACE_WITH_RANDOM_ARCHIVE_READER_PASSWORD
ARCHIVE_QUALITY_USER=archive_quality
ARCHIVE_QUALITY_PASSWORD=REPLACE_WITH_RANDOM_ARCHIVE_QUALITY_PASSWORD
ARCHIVE_POSTGRES_POOL_SIZE=5

# Archive browsing in the existing administrator backend; enable after migration 002.
ARCHIVE_QUERY_ENABLED=false
ARCHIVE_QUERY_POOL_SIZE=2
ARCHIVE_ASSIGNMENT_SYNC_ENABLED=false
ARCHIVE_ASSIGNMENT_USER=archive_assignment
ARCHIVE_ASSIGNMENT_PASSWORD=REPLACE_WITH_RANDOM_ASSIGNMENT_PASSWORD
# Enable after migrations 004_agent_presence through 007_presence_agent_management; 60-second sampling, one connection, one ICS instance.
# Retain observations for 45 days from sampled_at; daily 04:00 Asia/Shanghai cutoff is that anchor minus 45 days. Missed cleanup resumes with database-persisted progress and budgets.
ARCHIVE_PRESENCE_ENABLED=false
ARCHIVE_PRESENCE_USER=archive_presence
ARCHIVE_PRESENCE_PASSWORD=REPLACE_WITH_RANDOM_PRESENCE_PASSWORD
ARCHIVE_PRESENCE_MAX_AGENTS=100
ARCHIVE_EXPORT_MAX_ENTITIES=20000
ARCHIVE_EXPORT_MAX_MESSAGES=100000
ARCHIVE_EXPORT_MAX_BYTES=134217728
ARCHIVE_EXPORT_TIMEOUT_SECONDS=120
ARCHIVE_PROCESSOR_POOL_SIZE=2
ARCHIVE_PROCESSOR_LEASE_SECONDS=120
ARCHIVE_PROCESSOR_POLL_SECONDS=2
ARCHIVE_PROCESSOR_MAX_ATTEMPTS=8
# 同一客户最近 50 轮；历史保留，首次整理和旧事件修复可跨批次。
ARCHIVE_PROCESSOR_RECENT_ROUNDS=50
ARCHIVE_PROCESSOR_INDEX_BATCH_SIZE=500
ARCHIVE_PROCESSOR_INDEX_BATCH_BYTES=8388608
# 以下是单次解析批次的内存保护，不再限制会话累计历史。
ARCHIVE_PROCESSOR_MAX_CONVERSATION_EVENTS=20000
ARCHIVE_PROCESSOR_MAX_CONVERSATION_BYTES=67108864

# Optional signed Chatwoot account-webhook receiver (quality-capture profile).
# Fill the actual account IDs and the Secret of this dedicated account webhook.
ARCHIVE_SOURCE_KEY=chatwoot-main
ARCHIVE_ALLOWED_ACCOUNT_IDS=
ARCHIVE_WEBHOOK_SECRET=
# Initial host-only check; for same-server private access, set the actual server private IP.
# Example: ARCHIVE_RECEIVER_HOST=172.20.48.12 (use the same private IP as ICS).
ARCHIVE_RECEIVER_HOST=127.0.0.1
ARCHIVE_RECEIVER_PORT=3010
ARCHIVE_WEBHOOK_TOLERANCE_SECONDS=300
ARCHIVE_RECEIVER_MAX_BODY_BYTES=2097152

# 默认只允许本机/SSH 隧道/宿主机反向代理访问。
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=3001
ADMIN_USERNAME=Denpans
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
ADMIN_JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET

# 当前使用已有内网 Chatwoot；容器与访问前端的设备都应能访问此地址。
# 不带 /app、/api 或末尾斜杠；PUBLIC 表示浏览器访问地址，不要求公网。
CHATWOOT_BASE_URL=http://172.20.48.12:3000
CHATWOOT_PUBLIC_BASE_URL=http://172.20.48.12:3000
CHATWOOT_ACCOUNT_ID=
# 用户级管理员 API Token；不是 AgentBot Token，也不是 Website Token。
CHATWOOT_API_TOKEN=
CHATWOOT_CONTACT_API_TOKEN=
# AgentBot 创建后填写 ID/Token，并用真实 Secret 替换临时随机 Secret。
# 部署准备阶段也要有一个随机 Secret，避免 Webhook 在无签名校验状态下公开。
CHATWOOT_AGENT_BOT_ID=
CHATWOOT_AGENT_BOT_ACCESS_TOKEN=
CHATWOOT_AGENT_BOT_SECRET=REPLACE_WITH_TEMP_RANDOM_SECRET
# 首次只用 AgentBot 投递。另配 Account Webhook 时才填写它自己的 Secret。
CHATWOOT_WEBHOOK_SECRET=
# 在绑定测试 Inbox 前改为 true 并重建应用容器。
CHATWOOT_AUTO_REPLY_ENABLED=false

# 先部署 Chatwoot 评价补丁并关闭 Inbox 自带自动邀约，再改为 true。
CHATWOOT_CSAT_ENABLED=false
CHATWOOT_CSAT_MESSAGE=本次服务已结束，请评价本次服务。
CHATWOOT_CSAT_DISPLAY_TYPE=emoji
CHATWOOT_CSAT_API_TIMEOUT=5
CHATWOOT_WEBHOOK_TOLERANCE_SECONDS=300

# 首次用匿名访客测试，不在 URL 中传真实用户身份。
CHATWOOT_HMAC_TOKEN=
CHATWOOT_PROFILE_ALLOW_QUERY_IDENTIFIERS=false
CHATWOOT_PROFILE_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
CHATWOOT_SESSION_IDLE_TIMEOUT_SECONDS=21600
CHATWOOT_HANDOFF_ENABLED=true
CHATWOOT_HANDOFF_LABEL=handoff_required
CHATWOOT_HANDOFF_NOTICE_ENABLED=true
CHATWOOT_HANDOFF_TEAM_ID=
CHATWOOT_HANDOFF_ASSIGNEE_ID=
CHATWOOT_HANDOFF_MAX_ACTIVE_CONVERSATIONS=5
# 当前业务策略：封禁 1 天；依赖 contact_updated 事件被投递。
CHATWOOT_BLOCK_DURATION_SECONDS=86400
CHATWOOT_BLOCK_REAPER_INTERVAL_SECONDS=60
CHATWOOT_BLOCK_REAPER_BATCH_SIZE=100
CHATWOOT_API_TIMEOUT=15

# 所有模型路径使用容器内 /app 的相对路径，禁止填写 Windows 盘符。
RAG_PRETRAINED_MODEL_DIR=models/google-bert--bert-base-chinese/snapshots/master
RAG_OUTPUT_DIR=models/intent_classifier_bert
RAG_INTENT_DATASET_PATH=database/channel_xingliao/intent_dataset_4000.csv
RAG_INTENT_DATASET_VERIFY_FINGERPRINT=true
RAG_WARM_UP_ON_STARTUP=true
RAG_MEMORY_ENABLED=true
# 当前业务策略：闲置超过 15 天的记忆按批清理；轮次切换不立即删除旧记忆。
RAG_MEMORY_RETENTION_DAYS=15
WEBHOOK_IDEMPOTENCY_RETENTION_DAYS=7
FAQ_SOURCE_XLSX_PATH=database/channel_xingliao/最新问答对.xlsx
KNOWLEDGE_BASE_INPUT_DIR=database/channel_xingliao/knowledge_base
KNOWLEDGE_BASE_OUTPUT_PATH=knowledge_base_in/output/chunks.jsonl
KNOWLEDGE_BASE_EMBEDDING_MODEL_DIR=models/bge-m3
KNOWLEDGE_BASE_VECTOR_DB_DIR=knowledge_base_in/vector_store/chroma
# false：不加载/预热 reranker，直接使用双塔 Top5；true：沿用已有召回及精排 K 值配置。
# 修改后需重新创建 ics-agent 容器；未配置此项的旧环境默认 true。
RAG_RERANKER_ENABLED=false
RAG_RERANKER_MODEL_DIR=models/bge-reranker-v2-m3
KNOWLEDGE_BASE_OCR_ENABLED=true
# 服务器首次建库/推理批次仍设为 2，降低批次内存占用；代码默认批次为 8。
KNOWLEDGE_BASE_EMBEDDING_BATCH_SIZE=2
KNOWLEDGE_BASE_EMBEDDING_CPU_THREADS=2
KNOWLEDGE_BASE_EMBEDDING_CPU_INTEROP_THREADS=1
# 在线查询的 embedding 微批处理：最多等待 20ms，最多合并 4 个 query。
KNOWLEDGE_BASE_EMBEDDING_MICRO_BATCH_WAIT_MS=20
KNOWLEDGE_BASE_EMBEDDING_MICRO_BATCH_MAX_SIZE=4
RAG_RERANKER_BATCH_SIZE=2
RAG_RERANKER_MAX_CONCURRENCY=4

# 与当前测试基线一致；这些是单进程内的并发额度，不是 Uvicorn 进程数。
# 服务器尚未压测，资源紧张时按手册降低并发。
WEBHOOK_WORKER_COUNT=10
# 首测队列上限保留 100（代码默认 1000），避免堆积过多待处理请求。
WEBHOOK_QUEUE_MAX_SIZE=100
# 查询阶段总预算含 FAQ、检索、重排、模型槽位等待和重试；不含 worker 排队和回复写回。
WEBHOOK_RAG_TIMEOUT_SECONDS=30
WEBHOOK_PROCESSING_TIMEOUT_SECONDS=300
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=2
WEBHOOK_RETRY_BACKOFF_MULTIPLIER=2
WEBHOOK_RETRY_MAX_DELAY_SECONDS=30
LLM_MODEL=gpt-5.6-sol
LLM_MODEL_PROVIDER=openai
LLM_MODEL2=deepseek-flash
LLM_MODEL_PROVIDER2=
LLM_API_KEY=REPLACE_WITH_YOUR_LLM_API_KEY
LLM_BASE_URL=https://ai-sfo.apiveer.com/v1
LLM_API_KEY2=REPLACE_WITH_YOUR_FALLBACK_LLM_API_KEY
LLM_BASE_URL2=https://REPLACE_WITH_FALLBACK_LLM_HOST/v1
# 主模型首次调用最多 10 秒；失败/超时后模型 2 使用同一请求剩余预算。
LLM_TIMEOUT=10
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=8
LLM_CONCURRENCY_WAIT_TIMEOUT=15
LLM_MAX_TOKENS=1024
