# 服务器首次部署模板。复制到项目根目录 .env 后填写；不要覆盖本机正在使用的 .env。
# 适用：Ubuntu 22.04/24.04 x86_64，docker compose -f docker-compose.yml。
APP_ENV=production
LOG_LEVEL=INFO
TZ=Asia/Shanghai

# 机器人自己的 PostgreSQL，不连接 Chatwoot 的业务数据库。
# POSTGRES_DB（容器建库）与 POSTGRES_DATABASE（应用连接）必须一致。
POSTGRES_DB=cs
POSTGRES_DATABASE=cs
POSTGRES_USER=cs
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5433
POSTGRES_DSN=
POSTGRES_SSLMODE=disable

# 默认只允许本机/SSH 隧道/宿主机反向代理访问。
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=3001
ADMIN_USERNAME=csadmin
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_RANDOM_ADMIN_PASSWORD
ADMIN_JWT_SECRET=REPLACE_WITH_RANDOM_JWT_SECRET

# 替换为已有 Chatwoot 的实际 HTTPS 根地址，不带 /app、/api 或末尾斜杠。
CHATWOOT_BASE_URL=https://REPLACE_CHATWOOT_DOMAIN
CHATWOOT_PUBLIC_BASE_URL=https://REPLACE_CHATWOOT_DOMAIN
CHATWOOT_ACCOUNT_ID=
# 用户级管理员 API Token；不是 AgentBot Token，也不是 Website Token。
CHATWOOT_API_TOKEN=
CHATWOOT_CONTACT_API_TOKEN=
# AgentBot 创建后填写 ID/Token，并用真实 Secret 替换临时随机 Secret。
# 部署准备阶段也要有一个随机 Secret，避免 Webhook 在无签名校验状态下公开。
CHATWOOT_AGENT_BOT_ID=
CHATWOOT_AGENT_BOT_ACCESS_TOKEN=
CHATWOOT_AGENT_BOT_SECRET=REPLACE_WITH_TEMP_RANDOM_SECRET
# 首次只用 AgentBot 投递。另配 Account Webhook 时才填写它自己的 Secret。
CHATWOOT_WEBHOOK_SECRET=
# 在绑定测试 Inbox 前改为 true 并重建应用容器。
CHATWOOT_AUTO_REPLY_ENABLED=false
CHATWOOT_WEBHOOK_TOLERANCE_SECONDS=300

# 首次用匿名访客测试，不在 URL 中传真实用户身份。
CHATWOOT_HMAC_TOKEN=
CHATWOOT_PROFILE_ALLOW_QUERY_IDENTIFIERS=false
CHATWOOT_PROFILE_ALLOWED_ORIGINS=http://localhost:3001,http://127.0.0.1:3001
CHATWOOT_SESSION_IDLE_TIMEOUT_SECONDS=21600
CHATWOOT_HANDOFF_ENABLED=true
CHATWOOT_HANDOFF_LABEL=handoff_required
CHATWOOT_HANDOFF_NOTICE_ENABLED=true
CHATWOOT_HANDOFF_TEAM_ID=
CHATWOOT_HANDOFF_ASSIGNEE_ID=
CHATWOOT_HANDOFF_MAX_ACTIVE_CONVERSATIONS=5
# 本模板明确选择 7 天；项目根 .env.example 的值可能不同。
CHATWOOT_BLOCK_DURATION_SECONDS=604800
CHATWOOT_BLOCK_REAPER_INTERVAL_SECONDS=60
CHATWOOT_BLOCK_REAPER_BATCH_SIZE=100
CHATWOOT_API_TIMEOUT=15

# 所有模型路径使用容器内 /app 的相对路径，禁止填写 Windows 盘符。
RAG_PRETRAINED_MODEL_DIR=models/google-bert--bert-base-chinese/snapshots/master
RAG_OUTPUT_DIR=models/intent_classifier_bert
RAG_INTENT_DATASET_PATH=database/intent_dataset_4000.csv
RAG_INTENT_DATASET_VERIFY_FINGERPRINT=true
RAG_WARM_UP_ON_STARTUP=true
RAG_MEMORY_ENABLED=true
# 首测建议保留 30 天；轮次切换不等于立即删除旧记忆。
RAG_MEMORY_RETENTION_DAYS=30
WEBHOOK_IDEMPOTENCY_RETENTION_DAYS=7
FAQ_SOURCE_XLSX_PATH=database/最新问答对.xlsx
KNOWLEDGE_BASE_INPUT_DIR=database/knowledge_base
KNOWLEDGE_BASE_OUTPUT_PATH=knowledge_base_in/output/chunks.jsonl
KNOWLEDGE_BASE_EMBEDDING_MODEL_DIR=models/bge-m3
KNOWLEDGE_BASE_VECTOR_DB_DIR=knowledge_base_in/vector_store/chroma
RAG_RERANKER_MODEL_DIR=models/bge-reranker-v2-m3
KNOWLEDGE_BASE_OCR_ENABLED=true
KNOWLEDGE_BASE_EMBEDDING_BATCH_SIZE=2
KNOWLEDGE_BASE_EMBEDDING_CPU_THREADS=2
KNOWLEDGE_BASE_EMBEDDING_CPU_INTEROP_THREADS=1
RAG_RERANKER_BATCH_SIZE=2
RAG_RERANKER_MAX_CONCURRENCY=1

# 首次部署先采用保守并发；不同于本机可能已有的更大并发设置。
WEBHOOK_WORKER_COUNT=2
WEBHOOK_QUEUE_MAX_SIZE=100
WEBHOOK_RAG_TIMEOUT_SECONDS=120
WEBHOOK_PROCESSING_TIMEOUT_SECONDS=300
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=2
WEBHOOK_RETRY_BACKOFF_MULTIPLIER=2
WEBHOOK_RETRY_MAX_DELAY_SECONDS=30
LLM_MODEL=REPLACE_WITH_YOUR_WORKING_MODEL
LLM_MODEL_PROVIDER=openai
LLM_API_KEY=REPLACE_WITH_YOUR_LLM_API_KEY
LLM_BASE_URL=https://REPLACE_WITH_YOUR_LLM_API_BASE
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=2
LLM_CONCURRENCY_WAIT_TIMEOUT=15
LLM_MAX_TOKENS=1024
