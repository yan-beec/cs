# CS PostgreSQL 配置
POSTGRES_DB=cs
POSTGRES_USER=cs
POSTGRES_PASSWORD=change-me-postgres-password

# ics_agent 应用配置
APP_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=INFO
ANONYMIZED_TELEMETRY=false

# 本地 Uvicorn 启动器日志。每个活动日志文件达到 30 MB 后轮转。
UVICORN_LOG_DIRECTORY=log
UVICORN_LOG_MAX_BYTES=31457280
UVICORN_LOG_BACKUP_COUNT=5
UVICORN_STDOUT_LOG_FILENAME=uvicorn-admin.stdout.log
UVICORN_STDERR_LOG_FILENAME=uvicorn-admin.stderr.log

# 浏览器可访问的管理后台。
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=3001

# Chatwoot 运行在独立的 Compose 项目中。
CHATWOOT_BASE_URL=http://127.0.0.1:3000
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_WEBHOOK_SECRET=
# Chatwoot 签名时间戳允许的最大偏差，默认 5 分钟。
CHATWOOT_WEBHOOK_TOLERANCE_SECONDS=300
# 显式开启后，后台任务会把生成的答案发送回原 Chatwoot 会话。
CHATWOOT_AUTO_REPLY_ENABLED=false
# 用户输入“人工”或“转人工”后，开启 Chatwoot 人工接管动作。
CHATWOOT_HANDOFF_ENABLED=true
CHATWOOT_HANDOFF_LABEL=handoff_required
CHATWOOT_HANDOFF_NOTICE_ENABLED=true
# 可选：配置后自动分配到指定 Team / Agent；为空时依赖 Chatwoot 的分配规则。
CHATWOOT_HANDOFF_TEAM_ID=
CHATWOOT_HANDOFF_ASSIGNEE_ID=
CHATWOOT_API_TIMEOUT=15

# 系统管理员。部署前请替换这两个密钥值。
ADMIN_USERNAME=Denpans
ADMIN_INITIAL_PASSWORD=change-me-admin-password
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-please-replace-with-a-long-random-secret

# CS PostgreSQL。DSN 可选；为空时使用主机、端口和数据库字段。
POSTGRES_DSN=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DATABASE=cs
POSTGRES_USER=cs
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_SSLMODE=disable
POSTGRES_HOST_PORT=5433

# CS Redis。当前 CS Compose 将 Redis 映射到主机端口 6380。
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_HOST_PORT=6380
REDISINSIGHT_HOST_PORT=5540

# FAQ 启动初始化。
FAQ_SYNC_ON_STARTUP=true
# FAQ 工作簿刷新在后台执行。PostgreSQL 事务提交前，查询继续使用旧的
# 内存 FAQ 版本。

# RAG 启动初始化。
RAG_WARM_UP_ON_STARTUP=true
RAG_INTENT_DATASET_PATH=database/intent_dataset_4000.csv
RAG_MEMORY_ENABLED=true
RAG_MEMORY_WINDOW_TURNS=10
RAG_MEMORY_SUMMARY_INTERVAL=10
# 0 表示永久保留同一 Chatwoot 对话的 AI 记忆。
RAG_MEMORY_RETENTION_DAYS=0
RAG_MEMORY_CLEANUP_INTERVAL_SECONDS=86400
RAG_MEMORY_CLEANUP_BATCH_SIZE=500

# 知识库全量解析和向量入库的 CPU 保护。默认保守限流，速度会慢一些。
KNOWLEDGE_BASE_OCR_CPU_THREADS=2
KNOWLEDGE_BASE_OCR_CPU_INTEROP_THREADS=1
KNOWLEDGE_BASE_EMBEDDING_CPU_THREADS=2
KNOWLEDGE_BASE_EMBEDDING_CPU_INTEROP_THREADS=1
KNOWLEDGE_BASE_EMBEDDING_BATCH_PAUSE_SECONDS=0.1

# Chatwoot Webhook 后台队列、超时和幂等记录保留。
WEBHOOK_WORKER_COUNT=2
WEBHOOK_QUEUE_MAX_SIZE=1000
WEBHOOK_PROCESSING_TIMEOUT_SECONDS=60
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_INITIAL_DELAY_SECONDS=2
WEBHOOK_RETRY_BACKOFF_MULTIPLIER=2
WEBHOOK_RETRY_MAX_DELAY_SECONDS=30
WEBHOOK_QUEUE_SHUTDOWN_TIMEOUT_SECONDS=30
WEBHOOK_IDEMPOTENCY_RETENTION_DAYS=7
WEBHOOK_IDEMPOTENCY_STALE_AFTER_SECONDS=300
WEBHOOK_IDEMPOTENCY_CLEANUP_INTERVAL_SECONDS=86400
WEBHOOK_IDEMPOTENCY_CLEANUP_BATCH_SIZE=1000

# 云端 LLM 连接和提供商初始化。
LLM_MODEL=deepseek-flash
LLM_MODEL_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
