# CS MySQL
MYSQL_ROOT_PASSWORD=change-me-root-password
MYSQL_DATABASE=cs
MYSQL_USER=cs
MYSQL_PASSWORD=change-me-mysql-password

# ics_agent
APP_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=INFO

# Chatwoot is running in a separate Compose project.
CHATWOOT_BASE_URL=http://127.0.0.1:3000
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_WEBHOOK_SECRET=

# CS MySQL
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_POOL_NAME=ics_agent_mysql
MYSQL_POOL_SIZE=20
MYSQL_CONNECTION_TIMEOUT=5

# CS Redis. The current CS Compose maps Redis to host port 6380.
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_KEY_PREFIX=ics_agent:
REDIS_CONNECT_TIMEOUT=0.5
REDIS_SOCKET_TIMEOUT=0.5
REDIS_FAILURE_COOLDOWN_SECONDS=30
REDIS_HOST_PORT=6380
REDISINSIGHT_HOST_PORT=5540

# FAQ / BM25
FAQ_MATCH_THRESHOLD=0.85
FAQ_BM25_K1=1.5
FAQ_BM25_B=0.75
FAQ_SYNC_ON_STARTUP=true
FAQ_SOURCE_TABLE=faq_qna_optimized
FAQ_SOURCE_XLSX_PATH=database/最新问答对.xlsx
FAQ_CLEAR_ANSWER_CACHE_ON_SYNC=true
FAQ_TERMS=兴聊,言聊,星盈通
FAQ_QUESTION_IDS_KEY=faq:question_ids
FAQ_QUESTIONS_KEY=faq:questions
FAQ_QUESTION_TOKENS_KEY=faq:question_tokens
FAQ_QUESTIONS_META_KEY=faq:questions_meta
FAQ_QUERY_ANSWERS_KEY=faq:query_answers
FAQ_CACHE_INDEX_KEY=faq:query_answers:index
FAQ_CACHE_TTL_SECONDS=86400
FAQ_CACHE_MAX_ENTRIES=10000

# RAG / intent classification fine-tuning.
RAG_PRETRAINED_MODEL_DIR=models/google-bert--bert-base-chinese/snapshots/master
RAG_OUTPUT_DIR=models/intent_classifier_bert
RAG_NUM_LABELS=4
RAG_MAX_LENGTH=128
RAG_NUM_TRAIN_EPOCHS=3
RAG_LEARNING_RATE=0.00002
RAG_TRAIN_BATCH_SIZE=8
RAG_EVAL_BATCH_SIZE=8
RAG_WEIGHT_DECAY=0.01
RAG_WARMUP_RATIO=0.1
RAG_LOGGING_STEPS=10
RAG_SAVE_TOTAL_LIMIT=1
RAG_SEED=42
RAG_EVAL_RATIO=0.2
RAG_EVAL_DATASET_PATH=database/eval.csv

# Knowledge base parsing.
KNOWLEDGE_BASE_INPUT_DIR=database/knowledge_base
KNOWLEDGE_BASE_OUTPUT_PATH=knowledge_base_in/output/chunks.jsonl
KNOWLEDGE_BASE_CHUNK_SIZE_TOKENS=256
KNOWLEDGE_BASE_CHUNK_OVERLAP_TOKENS=32
KNOWLEDGE_BASE_TOKENIZER_DIR=models/google-bert--bert-base-chinese/snapshots/master
KNOWLEDGE_BASE_INCLUDE_HEADING_CONTEXT=true
KNOWLEDGE_BASE_DROP_HEADING_ONLY_CHUNKS=true
KNOWLEDGE_BASE_OCR_ENABLED=true
KNOWLEDGE_BASE_OCR_TEXT_SCORE=0.5

# Cloud LLM / LangChain.
LLM_MODEL=openai:gpt-4o-mini
LLM_MODEL_PROVIDER=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024
LLM_TIMEOUT=30
LLM_MAX_RETRIES=2
LLM_MAX_CONCURRENCY=5
LLM_CONCURRENCY_WAIT_TIMEOUT=5
LLM_API_KEY=
LLM_BASE_URL=
LLM_STRUCTURED_METHOD=function_calling
