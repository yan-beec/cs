# 应用运行环境。
APP_ENV=development
LOG_LEVEL=INFO

# PostgreSQL 配置。数据库连接的默认主机和 SSL 模式由代码提供。
POSTGRES_DB=cs
POSTGRES_USER=cs
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DATABASE=cs
POSTGRES_HOST_PORT=5433

# Docker 对外暴露管理后台。
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=3001

# Chatwoot 运行在独立的 Compose 项目中。
# 直接在本机启动服务时使用 127.0.0.1；服务放进 Docker 时改为 host.docker.internal。
CHATWOOT_BASE_URL=http://127.0.0.1:3000
# 浏览器访问客服页时使用的公网 Chatwoot 地址，例如 https://chat.example.com。
CHATWOOT_PUBLIC_BASE_URL=
CHATWOOT_API_TOKEN=
# 用户 API Token；联系人 blocked 查询/自动解除不能使用 AgentBot Token。
CHATWOOT_CONTACT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
# 只能放在后端环境变量中，不能放进 H5。
CHATWOOT_HMAC_TOKEN=
CHATWOOT_PROFILE_ALLOWED_ORIGINS=null,http://localhost:8090,http://127.0.0.1:8090
CHATWOOT_PROFILE_ALLOW_QUERY_IDENTIFIERS=false
CHATWOOT_WEBHOOK_SECRET=
# 当前推荐使用 AgentBot Webhook；普通 Account Webhook 不使用时保持为空。
# Chatwoot AgentBot 设置页面中的 Secret，通常与 Account Webhook Secret 不同。
CHATWOOT_AGENT_BOT_SECRET=
# 配置后，自动回复和状态操作会以 AgentBot 身份执行。
CHATWOOT_AGENT_BOT_ACCESS_TOKEN=
CHATWOOT_AGENT_BOT_ID=
CHATWOOT_AUTO_REPLY_ENABLED=false
CHATWOOT_HANDOFF_ENABLED=true
CHATWOOT_HANDOFF_LABEL=handoff_required
CHATWOOT_HANDOFF_NOTICE_ENABLED=true
CHATWOOT_HANDOFF_TEAM_ID=
CHATWOOT_HANDOFF_ASSIGNEE_ID=
# Chatwoot 联系人静音/拉黑自动解除配置。
# 1. 封禁时长，单位：秒。604800=7天，86400=1天，3600=1小时。
CHATWOOT_BLOCK_DURATION_SECONDS=604800
# 2. 到期扫描间隔，单位：秒。60=每分钟扫描一次。
CHATWOOT_BLOCK_REAPER_INTERVAL_SECONDS=60
# 3. 每次最多处理的到期联系人数量。
CHATWOOT_BLOCK_REAPER_BATCH_SIZE=100

# 系统管理员初始化密钥。
ADMIN_USERNAME=Denpans
ADMIN_INITIAL_PASSWORD=change-me-admin-password
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-please-replace-with-a-long-random-secret

# Redis 配置。Compose 容器内会覆盖 REDIS_URL 为容器网络地址。
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_HOST_PORT=6380
REDISINSIGHT_HOST_PORT=5540

# FAQ/RAG 启动行为。
FAQ_SYNC_ON_STARTUP=true
RAG_WARM_UP_ON_STARTUP=true
RAG_INTENT_DATASET_PATH=database/intent_dataset_4000.csv
RAG_INTENT_DATASET_VERIFY_FINGERPRINT=true
RAG_MEMORY_ENABLED=true
RAG_MEMORY_RETENTION_DAYS=0

# LLM 外部服务配置。
LLM_MODEL=deepseek-flash
LLM_MODEL_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
