# CS PostgreSQL
POSTGRES_DB=cs
POSTGRES_USER=cs
POSTGRES_PASSWORD=change-me-postgres-password

# ics_agent
APP_ENV=development
HOST=0.0.0.0
PORT=3001
LOG_LEVEL=INFO

# Browser-accessible administrator console.
ADMIN_WEB_HOST=127.0.0.1
ADMIN_WEB_PORT=3001

# Chatwoot is running in a separate Compose project.
CHATWOOT_BASE_URL=http://127.0.0.1:3000
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=
CHATWOOT_WEBHOOK_SECRET=

# System administrator. Replace both secret values before deployment.
ADMIN_USERNAME=Denpans
ADMIN_INITIAL_PASSWORD=change-me-admin-password
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-please-replace-with-a-long-random-secret

# CS PostgreSQL. The DSN is optional; host/port/database fields are used when empty.
POSTGRES_DSN=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DATABASE=cs
POSTGRES_USER=cs
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_SSLMODE=disable
POSTGRES_HOST_PORT=5433

# CS Redis. The current CS Compose maps Redis to host port 6380.
REDIS_URL=redis://127.0.0.1:6380/0
REDIS_HOST_PORT=6380
REDISINSIGHT_HOST_PORT=5540

# FAQ startup initialization.
FAQ_SYNC_ON_STARTUP=true
# FAQ workbook refresh runs in the background. Queries keep the previous
# in-memory FAQ version until the PostgreSQL transaction commits.

# RAG startup initialization.
RAG_WARM_UP_ON_STARTUP=true

# Cloud LLM connection and provider initialization.
LLM_MODEL=deepseek-flash
LLM_MODEL_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
