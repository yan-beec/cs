# 业务策略、并发和超时沿用当前测试配置；环境、地址、凭据及调试开关按部署填写。
# 未列出的参数使用 ics_agent/app/core/config.py 和 ics_agent/rag/config.py 默认值。
# 服务器使用 docker compose -f docker-compose.yml，避免加载开发热重载配置。
APP_ENV=production

# PostgreSQL：库名/用户名默认 cs；保留 5433，避免与 Chatwoot 数据库端口冲突。
# POSTGRES_PORT 供本机直接运行 Python 使用；Compose 内自动使用 postgres:5432。
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_PORT=5433
POSTGRES_HOST_PORT=5433

# 可选的独立归档/质检 PostgreSQL 数据库；通过 docker-compose.archive.yml 启用。
# 将这些配置与现有配置一并写入 .env；各账号使用互不相同的随机密码。
# ICS 使用受限查询账号；008后仅可通过专用函数追加人工质检备注，原始记录仍只读。
# 机器人容器中的管理员、采集和质检账号密码会被置空。
ARCHIVE_POSTGRES_DB=ics_quality
ARCHIVE_POSTGRES_HOST=archive-postgres
ARCHIVE_POSTGRES_PORT=5432
ARCHIVE_POSTGRES_ADMIN_PASSWORD=REPLACE_WITH_RANDOM_ARCHIVE_ADMIN_PASSWORD
ARCHIVE_INGEST_USER=archive_ingest
ARCHIVE_INGEST_PASSWORD=REPLACE_WITH_RANDOM_ARCHIVE_INGEST_PASSWORD
ARCHIVE_READER_USER=archive_reader
ARCHIVE_READER_PASSWORD=REPLACE_WITH_RANDOM_ARCHIVE_READER_PASSWORD
ARCHIVE_QUALITY_USER=archive_quality
ARCHIVE_QUALITY_PASSWORD=REPLACE_WITH_RANDOM_ARCHIVE_QUALITY_PASSWORD
# 4 核 16G 同机部署：优先保障原始写入；单接收进程最多 5 个归档连接。
ARCHIVE_POSTGRES_POOL_SIZE=5

# 在现有管理后台中浏览归档及保存双项质检备注；完成 001–009 数据库迁移后再启用。
ARCHIVE_QUERY_ENABLED=false
ARCHIVE_QUERY_POOL_SIZE=2
# Enable after migration 003; fixed responsibility from confirmed ICS assignments.
# Delivery has one source connection and one restricted archive connection.
ARCHIVE_ASSIGNMENT_SYNC_ENABLED=false
ARCHIVE_ASSIGNMENT_USER=archive_assignment
ARCHIVE_ASSIGNMENT_PASSWORD=REPLACE_WITH_RANDOM_ASSIGNMENT_PASSWORD
# 坐席黑名单历史同步到归档（需迁移 012_contact_blacklist）；复用上面的 archive_assignment 账号。
# 不填时跟随 ARCHIVE_ASSIGNMENT_SYNC_ENABLED。
# ARCHIVE_BLACKLIST_SYNC_ENABLED=true
# 完成 004_agent_presence 至 007_presence_agent_management 迁移后启用；每 60 秒采样、独立单连接池、单 ICS 实例。
# 按实际采样时间保留45天；每天北京时间04:00按该时刻减45天分批清理，漏清次日补清，预算和进度保存于数据库。
ARCHIVE_PRESENCE_ENABLED=false
ARCHIVE_PRESENCE_USER=archive_presence
ARCHIVE_PRESENCE_PASSWORD=REPLACE_WITH_RANDOM_PRESENCE_PASSWORD
# 默认最多采集 100 个坐席，可设置 1–200；不调整采样周期或采集线程数。
ARCHIVE_PRESENCE_MAX_AGENTS=100
# 单次导出最多 1000 个轮次/用户、5000 条消息；索引 JSON 预算 8 MiB、生成时限 60 秒。
# JSON 预算不是进程内存或临时磁盘硬配额；CPU/内存硬隔离需另配独立导出进程。
ARCHIVE_EXPORT_MAX_ENTITIES=1000
ARCHIVE_EXPORT_MAX_MESSAGES=5000
ARCHIVE_EXPORT_MAX_BYTES=8388608
ARCHIVE_EXPORT_TIMEOUT_SECONDS=60
# 离线 HTML 留档使用独立预算，不受上方 Excel 消息条数限制；默认目录随 database 卷持久化。
ARCHIVE_OFFLINE_DIRECTORY=database/archive-exports
ARCHIVE_OFFLINE_MAX_BYTES=21474836480
ARCHIVE_OFFLINE_DISK_BUDGET_BYTES=53687091200
ARCHIVE_OFFLINE_MIN_FREE_BYTES=2147483648
ARCHIVE_OFFLINE_MAX_FILE_BYTES=2147483648
# 单页 HTML 内嵌上限：单张图片 5 MiB、单个视频/音频 100 MiB、全页合计 800 MiB，超限的保留原始链接。
ARCHIVE_OFFLINE_MAX_EMBED_BYTES=5242880
ARCHIVE_OFFLINE_MAX_EMBED_VIDEO_BYTES=104857600
ARCHIVE_OFFLINE_MAX_EMBEDDED_TOTAL_BYTES=838860800
ARCHIVE_OFFLINE_TIMEOUT_SECONDS=86400
ARCHIVE_OFFLINE_MEDIA_TIMEOUT_SECONDS=20
ARCHIVE_OFFLINE_RETENTION_DAYS=7
# HTML 首次完整下载后服务器端再保留的小时数（期间可重新下载），之后删除。
ARCHIVE_OFFLINE_DOWNLOADED_HOURS=2
# 生成后一直未下载的，超过该小时数自动删除。
ARCHIVE_OFFLINE_UNCLAIMED_HOURS=24
# 生成在独立低优先级子进程中进行：平均最多占用的 CPU 核数（0 不限）、nice 值、虚拟内存上限（0 不限）。
ARCHIVE_OFFLINE_CPU_LIMIT=0.5
ARCHIVE_OFFLINE_NICE=19
ARCHIVE_OFFLINE_MEMORY_LIMIT_BYTES=4294967296
# 导出前数量预估：超过提醒线需二次确认，超过上限拒绝生成（浏览器打不开过大的单页）。
ARCHIVE_OFFLINE_WARN_MESSAGES=30000
ARCHIVE_OFFLINE_MAX_MESSAGES=300000
ARCHIVE_OFFLINE_WARN_ROUNDS=5000
ARCHIVE_OFFLINE_MAX_ROUNDS=50000
ARCHIVE_OFFLINE_ESTIMATE_TIMEOUT_SECONDS=60
# 额外允许的附件存储源，逗号分隔，例如 https://media.example.com；Chatwoot 内外地址自动允许。
ARCHIVE_OFFLINE_MEDIA_ORIGINS=
# 单解析进程串行整理；最多使用 1 个连接。
ARCHIVE_PROCESSOR_POOL_SIZE=1
ARCHIVE_PROCESSOR_LEASE_SECONDS=120
ARCHIVE_PROCESSOR_POLL_SECONDS=2
ARCHIVE_PROCESSOR_MAX_ATTEMPTS=8
# 客户日常重算最近 50 轮；首次整理、历史修复分批执行，旧历史继续保留和查询。
ARCHIVE_PROCESSOR_RECENT_ROUNDS=50
ARCHIVE_PROCESSOR_INDEX_BATCH_SIZE=500
ARCHIVE_PROCESSOR_INDEX_BATCH_BYTES=8388608
# 每个解析批次最多 5000 个事件、16 MiB；过大自动缩小轮次批次，单轮仍超限才告警。
ARCHIVE_PROCESSOR_MAX_CONVERSATION_EVENTS=5000
ARCHIVE_PROCESSOR_MAX_CONVERSATION_BYTES=16777216

# 可选的 Chatwoot 账户级 Webhook 签名校验接收服务（quality-capture 配置组）。
# 填写实际的账户 ID，以及此专用账户级 Webhook 的签名密钥。
ARCHIVE_SOURCE_KEY=chatwoot-main
ARCHIVE_ALLOWED_ACCOUNT_IDS=
ARCHIVE_WEBHOOK_SECRET=
# 初次检查时仅允许本机访问；同机服务通过内网访问时，填写服务器实际内网 IP。
# 示例：ARCHIVE_RECEIVER_HOST=172.20.48.12（与 ICS 使用相同的内网 IP）。
ARCHIVE_RECEIVER_HOST=127.0.0.1
ARCHIVE_RECEIVER_PORT=3010
ARCHIVE_WEBHOOK_TOLERANCE_SECONDS=300
ARCHIVE_RECEIVER_MAX_BODY_BYTES=2097152

# 管理后台：默认端口 3001、用户名 Denpans；服务器通过反向代理或 SSH 隧道访问。
# 初始密码仅在首次建管理员时生效；已有账号不会随此配置改密。
ADMIN_WEB_HOST=127.0.0.1
ADMIN_INITIAL_PASSWORD=change-me-admin-password
ADMIN_JWT_SECRET=change-me-admin-jwt-secret-please-replace-with-a-long-random-secret

# Chatwoot：BASE_URL 填机器人后端可达地址，PUBLIC_BASE_URL 填浏览器可达地址。
# Docker Desktop 可用 host.docker.internal；当前 Linux Compose 未配置该别名。
CHATWOOT_BASE_URL=http://REPLACE_WITH_CHATWOOT_HOST:3000
CHATWOOT_PUBLIC_BASE_URL=https://chat.example.com
# 用户级 API Token；专用 CONTACT Token 留空时复用 API_TOKEN。
CHATWOOT_API_TOKEN=
CHATWOOT_CONTACT_API_TOKEN=
# 从 AgentBot 详情填写 Secret / Access Token / ID；Secret 不能留空，否则跳过签名校验。
CHATWOOT_AGENT_BOT_SECRET=change-me-agent-bot-secret
CHATWOOT_AGENT_BOT_ACCESS_TOKEN=
CHATWOOT_AGENT_BOT_ID=
# 完成凭据配置并绑定测试 Inbox 后改为 true，开始自动回复。
CHATWOOT_AUTO_REPLY_ENABLED=false

# 按咨询轮次发送评价；先部署 deploy/chatwoot/ics_csat_rounds.rb 并关闭 Inbox 自带自动邀约。
CHATWOOT_CSAT_ENABLED=false
CHATWOOT_CSAT_MESSAGE=本次服务已结束，请评价本次服务。
CHATWOOT_CSAT_DISPLAY_TYPE=emoji
CHATWOOT_CSAT_API_TIMEOUT=5

# 身份接口：部署默认关闭 URL 身份调试；正式身份由业务后端验证登录态后签发。
# HMAC 仅供需要该签名能力的后端使用；ALLOWED_ORIGINS 填实际前端来源。
CHATWOOT_HMAC_TOKEN=
# 新渠道启用 Website Inbox 身份校验时，填写对应 Inbox 的 HMAC 密钥；兴聊沿用上方配置。
CHATWOOT_CHANNEL_HMAC_TOKENS={"yanliao":"","xingyingtong":"","wechat":""}
CHATWOOT_PROFILE_ALLOWED_ORIGINS=https://app.example.com
CHATWOOT_PROFILE_ALLOW_QUERY_IDENTIFIERS=false

# 当前业务策略：封禁 1 天、会话记忆保留 15 天（代码默认分别为 7 天、永久）。
CHATWOOT_BLOCK_DURATION_SECONDS=86400
CHATWOOT_BLOCK_REAPER_INTERVAL_SECONDS=60
# 坐席客户端黑名单（24h/72h/永久、原因、解除备注、操作历史）；独立连接池，关闭不影响原有禁言与转人工拒接。
# 上面的 CHATWOOT_BLOCK_DURATION_SECONDS 仅用于 Chatwoot 网页端直接拉黑。
CHATWOOT_BLACKLIST_ENABLED=true
CHATWOOT_BLACKLIST_RECONCILE_SECONDS=30
# 坐席客户端快捷回复跨设备同步（启动时自动建表 agent_quick_replies）
CHATWOOT_QUICK_REPLIES_ENABLED=true
RAG_MEMORY_RETENTION_DAYS=15

# LLM：使用已调用成功的模型、API Key 和 OpenAI 兼容接口地址。
LLM_MODEL=gpt-5.6-sol
LLM_MODEL2=deepseek-flash
# LLM_MODEL_PROVIDER2 留空时复用主模型提供商。
LLM_MODEL_PROVIDER2=
LLM_API_KEY=
LLM_BASE_URL=https://ai-sfo.apiveer.com/v1
LLM_API_KEY2=
LLM_BASE_URL2=

# 当前测试使用的并发/超时基线，部署后按服务器资源和响应耗时调整。
# 30 秒是 RAG 总时限；主模型首次调用最多 10 秒，失败/超时后使用模型 2 的剩余预算。
WEBHOOK_WORKER_COUNT=10
# 精排设置：4 核 / 16 GB CPU 起始方案，按实际耗时与内存占用调整。
# false：跳过精排及其模型预热，直接双塔召回 Top5 回复；true：沿用以下精排配置。
# 修改后需重启服务；Docker 部署需重新创建应用容器以更新环境变量。
RAG_RERANKER_ENABLED=false
# 输入为参与精排的候选文档数，输出为提供给大模型的文档数。
RAG_RERANKER_INPUT_TOP_K=8
RAG_RERANKER_OUTPUT_TOP_K=3
# 每批计算的问题与文档配对数，不是并发会话数。
RAG_RERANKER_BATCH_SIZE=8
# 同时执行精排的请求数；先从 1 开始，再测试 2。
RAG_RERANKER_MAX_CONCURRENCY=1
# 每个问题与文档配对分词后的最大总长度，超过时截断。
RAG_RERANKER_MAX_LENGTH=512
LLM_MAX_CONCURRENCY=8
LLM_CONCURRENCY_WAIT_TIMEOUT=15
POSTGRES_POOL_SIZE=12
POSTGRES_POOL_ACQUIRE_TIMEOUT=1.0
LLM_TIMEOUT=10
WEBHOOK_RAG_TIMEOUT_SECONDS=30
KNOWLEDGE_BASE_EMBEDDING_MICRO_BATCH_WAIT_MS=20
KNOWLEDGE_BASE_EMBEDDING_MICRO_BATCH_MAX_SIZE=4

# ICS 桌面提醒插件；仍由原 ICS 提供服务。
REMINDER_ENABLED=false
REMINDER_POLL_SECONDS=2
REMINDER_REPEAT_SECONDS=30
# 插件账号与 ICS 管理员独立。填写自选插件密码和随机签名密钥。
REMINDER_PLUGIN_USERNAME=reminder
REMINDER_PLUGIN_PASSWORD=
# 可用 PBKDF2 哈希代替明文；非空时优先验证哈希。
REMINDER_PLUGIN_PASSWORD_HASH=
REMINDER_PLUGIN_SECRET=
# 留空允许当前 Chatwoot 账户所有席位；指定时用逗号分隔，如 11,12。
REMINDER_PLUGIN_ALLOWED_AGENT_IDS=
# 每个席位最多同时有效的插件客户端数量；第4台绑定/切换时才吊销最旧设备。
REMINDER_PLUGIN_MAX_DEVICES_PER_AGENT=3
# 仅首次选择/注册设备所用的登录令牌有效期，记住设备后不需定时重登。
REMINDER_PLUGIN_SESSION_EXPIRE_SECONDS=3600
